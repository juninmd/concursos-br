{
  "name": "concursos-br",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Digest diário de concursos públicos e editais via Telegram (RSS + IA, pt-BR).",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts --loop",
    "ingest": "bun run src/index.ts --ingest",
    "digest": "bun run src/index.ts --digest",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "@juninmd/digest-kit": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
